# Guichet de l'agent (fonction edge Supabase)
PRINT_AGENT_URL=https://ppmtoiqgajwcdkbnrcll.supabase.co/functions/v1/print-agent

# Jeton de l'agent, obtenu à l'enregistrement (voir README, étape 2).
# Ne se retrouve pas : la base n'en garde que l'empreinte sha256.
PRINT_AGENT_TOKEN=

# Nom de la file CUPS de l'imprimante d'étiquettes (lpstat -p)
PRINT_QUEUE=QL820

# Intervalle de relève de la file, en millisecondes
POLL_MS=2000

# Options `lp` supplémentaires, séparées par des espaces. Vide dans le cas
# normal : CUPS utilise alors le rouleau chargé, donc le bon format.
LP_OPTIONS=
